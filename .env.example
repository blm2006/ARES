# Cấu hình giai đoạn THU DỮ LIỆU KHỞI TẠO (không phải cấu hình production).
# Mọi ngưỡng đọc từ đây; không chỗ nào trong code hardcode lại.

ENV=dev
LOG_LEVEL=INFO
DATA_ROOT=./var

# ---- camera
CAMERAS=cam01=0

# ---- model
YOLO_WEIGHTS=yolov8n.pt
YOLO_BASE_CHECKPOINT=yolov8n.pt
DEVICE=cuda:0
HALF=true
IMGSZ=640
CONF_THRESHOLD=0.15
TARGET_FPS=25
TRACKER_TYPE=bytetrack

# ---- queue
# sqlite = không cần Redis, không cần Docker, vẫn có persistence.
# Đổi sang redis thì phải `docker compose up -d` TRƯỚC, nếu không Phase 2 chết ngay
# với ConnectionError 10061.
QUEUE_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0
QUEUE_STREAM=frames
QUEUE_GROUP=workers

# ---- sampling router -------------------------------------------------------
# Hạn mức tính theo NGÀY. Dùng hết thì collector NGỪNG nhận tới 00:00 hôm sau —
# đó là thiết kế, không phải lỗi. `python -m scripts.status_monitor` hiện % đã dùng.
#   uncertainty = 5000*0.50 = 2500/ngày
#   failure     = 5000*0.30 = 1500/ngày
#   random      = 5000*0.20 = 1000/ngày
DAILY_SAMPLE_BUDGET=5000
QUOTA_UNCERTAINTY=0.50
QUOTA_FAILURE=0.30
QUOTA_RANDOM=0.20
# 50% = lấy nửa số frame "bất định nhất". Cố ý rộng để gom dữ liệu khởi tạo cho nhanh.
# Có dataset v001 rồi thì HẠ VỀ 5-15, nếu không nguồn A gần như trùng nguồn C và phép
# so ablation (A có thắng random không) mất ý nghĩa.
UNCERTAINTY_TOP_PERCENTILE=50.0
UNCERTAINTY_WINDOW_HOURS=24
UNCERTAINTY_MIN_SAMPLES=100
RANDOM_SAMPLE_RATE=1.0

# 1.0 = bỏ trần theo giờ / theo camera. Chỉ hợp lệ khi thu khởi tạo với 1 camera.
# Nhiều camera hoặc chạy dài ngày thì trả về 0.12 / 0.40, nếu không 80% dataset sẽ là
# giờ cao điểm của camera ồn nhất.
PER_HOUR_CAP_RATIO=1.0
PER_CAMERA_CAP_RATIO=1.0

# ---- backpressure
QUEUE_DEPTH_N1=2000
QUEUE_DEPTH_N2=10000
DISK_FREE_MIN_PCT=10

# ---- dedup -----------------------------------------------------------------
# PCA đã freeze bằng embedder 'hist_v1' (512 -> 128 chiều). Muốn đổi sang embedder
# yolo: BUMP PCA_VERSION rồi reindex toàn bộ — ghi đè file cũ là hỏng dedup âm thầm.
PCA_VERSION=pca_v1
PCA_COMPONENTS=128
PCA_FIT_MIN_SAMPLES=2000
# THETA ĐO TRÊN DỮ LIỆU THẬT CỦA BẠN, không phải số mặc định.
# Camera cố định + embedder histogram màu => frame gần nhau có cosine rất cao
# (trung vị với hàng xóm gần nhất = 0.9915). Chạy thật trên 2111 frame đã thu:
#     theta 0.94  -> giữ  100 ( 4.7%)   <- mặc định cũ, vứt gần hết
#     theta 0.97  -> giữ  156 ( 7.4%)
#     theta 0.99  -> giữ  303 (14.4%)
#     theta 0.995 -> giữ  488 (23.1%)   <- chọn: đủ mẫu để duyệt, vẫn bỏ 77% trùng
#     theta 0.998 -> giữ  735 (34.8%)
# Nếu sau này đổi sang embedder yolo (ngữ nghĩa hơn màu) thì hạ theta về ~0.94.
DEDUP_THETA=0.995
DEDUP_THETA_FAILURE=0.998
CORESET_ENABLED=true
CORESET_KEEP_RATIO=0.7

# ---- dataset
ROLLING_DAYS=30
SPLIT_RATIOS=0.8,0.1,0.1

# ---- training
TRAIN_TRIGGER_MIN_NEW=500
TRAIN_TRIGGER_MAP_DROP_PCT=2
TRAIN_TRIGGER_AGREEMENT_DROP_PCT=3
TRAIN_EPOCHS=40
TRAIN_BATCH=16
TRAIN_OLD_DATA_RATIO=0.70
VAL_PER_CAMERA_MAX_DROP_PCT=2
VAL_PRIMARY_METRIC=recall50

# ---- deploy
SHADOW_MIN_HOURS=24
CANARY_MIN_HOURS=24
ROLLBACK_COUNT_DRIFT_PCT=15
ROLLBACK_ID_SWITCH_INCREASE_PCT=25
ROLLBACK_FPS_DROP_PCT=15

# ---- governance
IMAGE_TTL_DAYS=90
AUDIT_LOG_ENABLED=true
