# Cấu hình ARES. Sao chép thành ares_config/ares.env rồi sửa (tệp này KHÔNG commit lên git).
# Mọi biến có tiền tố ARES_. Chỉ cần ghi những gì khác mặc định.
# Kiểm tra: python -m ares check

# ---- chung ---------------------------------------------------------------------------------
ARES_ROOM_ID=P101
ARES_TIMEZONE=Asia/Ho_Chi_Minh
# ARES_STORAGE_ROOT=D:/ares-data          # nơi lưu DB, ảnh chờ duyệt, model; mặc định var/ares trong dự án
# ARES_DB_URL=postgresql+psycopg://user:mk@localhost/ares   # rỗng = SQLite trong storage_root

# ---- camera + YOLO ---------------------------------------------------------------------------
ARES_CAMERA_SOURCE=0                      # 0 = webcam USB; hoặc rtsp://...; hoặc đường dẫn video để chạy thử
ARES_WEIGHTS=yolov8n.pt                   # model gốc; model đã retrain nằm trong sổ đăng ký (tab Model)
ARES_DEVICE=auto                          # auto | cpu | cuda:0
ARES_VISION_FPS=15                        # bình thường: "full FPS" (giới hạn trên; thực tế <= FPS camera / tốc độ YOLO)
ARES_VISION_FPS_TRAINING=1                # đang train: tự hạ để nhường GPU/CPU, train xong tự trả lại
# ARES_HUB_FPS=5                          # camera phụ: số vòng/giây qua mọi camera phụ
# ARES_HUB_FPS_TRAINING=1
# (ARES_VISION_INTERVAL_S chỉ còn dùng cho chế độ mô phỏng)

# ---- MQTT (broker: docker compose --profile ares up -d) --------------------------------------
ARES_MQTT_HOST=localhost
ARES_MQTT_PORT=1883
ARES_MQTT_USERNAME=ares
ARES_MQTT_PASSWORD=
ARES_MQTT_PREFIX=ares                     # topic: ares/<phòng>/sensors | cmd/led | cmd/ac | status/...

# ---- dashboard -------------------------------------------------------------------------------
# Mặc định chỉ mở ở máy này (127.0.0.1). Muốn xem từ máy khác phải đặt TOKEN (ảnh có người trong đó).
ARES_DASHBOARD_HOST=127.0.0.1
ARES_DASHBOARD_PORT=8100
# ARES_DASHBOARD_HOST=0.0.0.0
# ARES_DASHBOARD_TOKEN=doi-thanh-chuoi-bi-mat-dai

# ---- chiếu sáng (spec) -----------------------------------------------------------------------
# ARES_KP=0.5
# ARES_LUX_OCCUPIED=400
# ARES_LUX_DENSE=450
# ARES_LUX_IDLE=100
# ARES_LED_WATTS=[60,60,60,60]            # công suất đèn mỗi vùng (W), chỉ để ước tính điện năng
# -- chống bật/tắt liên tục (chỉnh được trực tiếp ở tab "Thiết bị" trên dashboard; giá trị đó sẽ ĐÈ lên đây)
# ARES_OCC_ON_THRESHOLD=0.35              # bật: trung bình 30 s số người >= ngưỡng này
# ARES_OCC_OFF_THRESHOLD=0.15             # hết người: < ngưỡng này (khoảng giữa = vùng trễ)
# ARES_LIGHT_ON_DELAY_S=10                # trễ bật
# ARES_EMPTY_DIM_AFTER_S=180              # trễ hạ về nền
# ARES_ROOM_OFF_AFTER_S=180               # trễ tắt cả phòng
# ARES_LUX_DEADBAND=30                    # vùng chết ± lux
# ARES_PWM_MAX_STEP=15                    # %/nhịp
# ARES_PWM_OCCUPIED_MIN=0                 # dải PWM khi có người
# ARES_PWM_OCCUPIED_MAX=100

# ---- điều hòa (spec) -------------------------------------------------------------------------
# ARES_T_BASE=26.5
# ARES_T_MIN=22
# ARES_T_MAX=27
# ARES_DEADBAND=0.7
# ARES_FAILSAFE_MIN=15
# -- chống bật/tắt liên tục
# ARES_AC_ON_DELAY_S=120                  # trễ bật theo hiện diện
# ARES_AC_OFF_DELAY_S=300                 # trễ tắt khi phòng trống (cộng sau cửa sổ 10 phút)
# ARES_AC_MIN_ON_S=600                    # đã bật thì chạy ít nhất 10 phút
# ARES_AC_MIN_OFF_S=300                   # đã tắt thì nghỉ ít nhất 5 phút (bảo vệ máy nén, áp dụng cả pre-cool)
# ARES_MIN_CMD_INTERVAL_S=300             # giãn cách giữa 2 lệnh IR không khẩn cấp
# ARES_AC_KEEP_ON_BEFORE_CLASS_MIN=30     # phòng trống nhưng sắp vào lớp trong 30 phút thì không tắt
# ARES_AC_SETPOINT_MAX_STEP=2             # °C mỗi lệnh
# ARES_FAN_MIN=1
# ARES_FAN_MAX=3
# ARES_FAN_HYSTERESIS=0.05

# ---- học chủ động + retrain ban đêm ----------------------------------------------------------
# ARES_AL_DAILY_CAP=0                     # 0 = không giới hạn ảnh/ngày (giảm số lượng do lọc PCA đảm nhiệm)

# ---- Lọc PCA 2 giai đoạn + nhiều camera --------------------------------------
# ARES_PCA_ENABLED=true                   # false: ảnh vào thẳng hàng chờ duyệt, không lọc
# ARES_PCA_FIT_MIN=300                    # số khung hình mẫu để tự khởi tạo PCA (camera lấy mẫu mỗi 30 s)
# ARES_PCA_Q_REVIEW=0.5                   # lọc trước khi duyệt: càng cao càng gắt tay
# ARES_PCA_Q_TRAIN=0.8                    # lọc trước khi train: mạnh hơn lần 1
# ARES_CAMERA_AUTO_DETECT=true            # tự dò camera USB cắm thêm; camera mạng khai trong ares_config/cameras.json
# ARES_RETRAIN_ENABLED=true
# ARES_RETRAIN_TIME=00:00
# ARES_REPLAY_DIR=D:/yolo-al/dataset/yolo   # dataset YOLO gốc làm replay buffer (images/, labels/). Nên đặt!
# ARES_AUTO_PROMOTE=always                  # always = train xong hoán đổi ngay (cổng chỉ cảnh báo) | gated | never
# ARES_DUPLICATE_TTL_DAYS=0                 # 0 = ảnh bị lọc trùng XOÁ NGAY | >0 = giữ chừng này ngày, khôi phục được
