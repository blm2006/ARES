# Cấu hình server trung tâm khi chạy trực tiếp bằng Python (chép thành ares_config/server.env)
# ARES_SERVER_HOST=127.0.0.1             # 0.0.0.0 = mở cho máy khác trong mạng (BẮT BUỘC đặt mật khẩu)
# ARES_SERVER_PORT=8200
# Tài khoản đăng nhập tạo trên dashboard (lần đầu mở http://127.0.0.1:8200 trên máy chủ) và lưu trong DB server.
# Hai dòng dưới chỉ dùng cho Docker/VPS: nếu DB chưa có tài khoản, server tự tạo quản trị viên từ đây ở lần chạy đầu.
# ARES_SERVER_ADMIN_USER=admin
# ARES_SERVER_ADMIN_PASSWORD=
# ARES_SERVER_MEDIA_KEEP_DAYS=30         # ảnh/clip sự kiện chưa đánh giá tự xoá sau 30 ngày
# ARES_SERVER_OFFLINE_AFTER_S=120        # quá 2 phút không nhận heartbeat => "Mất kết nối"
